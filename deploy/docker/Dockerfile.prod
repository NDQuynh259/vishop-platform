# =============================================================================
# ViShop Platform - Production Hardened Dockerfile
# =============================================================================
# Stage 1: Build
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /build

RUN apk add --no-cache dos2unix

COPY gradlew gradlew.bat settings.gradle.kts build.gradle.kts ./
COPY gradle ./gradle
RUN dos2unix gradlew && chmod +x gradlew

COPY platform-common ./platform-common
COPY services ./services

ARG SERVICE_NAME
RUN if [ -z "$SERVICE_NAME" ]; then echo "SERVICE_NAME argument is required" && exit 1; fi

RUN ./gradlew :services:${SERVICE_NAME}:bootJar --no-daemon -x test
RUN cp services/${SERVICE_NAME}/build/libs/*.jar /build/app.jar

# Stage 2: Hardened Minimal JRE Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN apk add --no-cache curl

# Create dedicated non-root user and group
RUN addgroup -S appgroup -g 1001 && \
    adduser -S appuser -u 1001 -G appgroup

COPY --from=builder --chown=appuser:appgroup /build/app.jar /app/app.jar

USER appuser:appgroup

ARG SERVICE_PORT=8080
ENV PORT=${SERVICE_PORT}
ENV SPRING_PROFILES_ACTIVE="prod"

# Production JVM tuning: G1GC, container-aware RAM percentage, exit on OOM to let orchestrator restart
ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom"

EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=30s \
  CMD curl -f http://localhost:${PORT}/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
