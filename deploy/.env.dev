# =============================================================================
# ViShop Platform - Development Environment Configuration (.env.dev)
# =============================================================================
SPRING_PROFILES_ACTIVE=dev

# --- Service HTTP Ports ---
GATEWAY_PORT=8000
IDENTITY_PORT=8080
TENANT_PORT=8081
AUDIT_PORT=8082

# --- JVM Remote Debugging Ports (JDWP) ---
GATEWAY_DEBUG_PORT=5000
IDENTITY_DEBUG_PORT=5001
TENANT_DEBUG_PORT=5002
AUDIT_DEBUG_PORT=5003

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vishop
POSTGRES_PASSWORD=vishop_secret
POSTGRES_DB=vishop_platform

# --- Message Broker (Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# --- JVM Options for Local Development ---
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
