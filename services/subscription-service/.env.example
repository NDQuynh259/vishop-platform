# Copy to .env.dev or .env.prod to override the Compose defaults for Subscription.
SUBSCRIPTION_DATASOURCE_URL=
SUBSCRIPTION_DATASOURCE_USERNAME=
SUBSCRIPTION_DATASOURCE_PASSWORD=
# For PostgreSQL published by a separate local stack, use host.docker.internal instead of postgres.
SUBSCRIPTION_PORT=8083
SUBSCRIPTION_DEBUG_PORT=5004

# Fill bank details and the HMAC secret before enabling SePay.
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_MEMO_PREFIX=
