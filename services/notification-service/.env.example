# Supply these values to the Spring Boot host that runs Notification.
# Runtime datasource for a standalone Notification host:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vishop_notification
# SPRING_DATASOURCE_USERNAME=vishop_notification_app
# SPRING_DATASOURCE_PASSWORD=

# Standalone migration CLI:
# NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/vishop_notification
# NOTIFICATION_DB_USER=vishop_notification_migrator
# NOTIFICATION_DB_PASSWORD=

NOTIFICATION_RETENTION_ENABLED=false
# NOTIFICATION_RETENTION_PERIOD=90d
# NOTIFICATION_RETENTION_BATCH_SIZE=500
