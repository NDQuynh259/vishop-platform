# Copy to .env.dev or .env.prod and supply a key distinct from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optional Docker Compose overrides. The standard defaults are in Compose/Spring YAML.
# IAM_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vishop_iam
# IAM_DATASOURCE_USERNAME=vishop_iam_app
# IAM_DATASOURCE_PASSWORD=
# IAM_PORT=8080
# IAM_DEBUG_PORT=5001
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=Lax
