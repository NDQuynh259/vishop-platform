# =============================================================================
# ViShop Platform - Environment Variables Template
# =============================================================================
# Copy this file to infra/.env.dev and fill in credentials before starting:
#   cp infra/.env.example infra/.env.dev

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vishop
POSTGRES_PASSWORD=

# --- Message Broker (Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Observability & Distributed Tracing (OTLP / Jaeger) ---
GRAFANA_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# --- JVM Performance ---
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -Djava.security.egd=file:/dev/./urandom
SPRING_PROFILES_ACTIVE=dev

# Shared HS256 access key for IAM and Gateway, at least 32 UTF-8 bytes.
JWT_ACCESS_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Gateway-only backend ingress; shared Auth Redis supplies role permissions.
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6380
AUTH_REDIS_DATABASE=0
AUTH_REDIS_PASSWORD=
CACHE_KEY_PREFIX=vishop:
AUTH_CACHE_MAX_AGE_SECONDS=30
