# =============================================================================
# ViShop Platform - Environment Variables Template
# =============================================================================
# Copy this file to .env in the deploy directory:
#   cp infra/.env.example infra/.env

# --- Ports ---
GATEWAY_PORT=8000
IAM_PORT=8080
AUDIT_PORT=8082

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vishop
POSTGRES_PASSWORD=vishop_secret

# --- Message Broker (Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Observability & Distributed Tracing (OTLP / Jaeger) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# --- JVM Performance ---
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -Djava.security.egd=file:/dev/./urandom
SPRING_PROFILES_ACTIVE=prod

# JWT signing secret: set a random value of at least 32 bytes.
JWT_SECRET=
# Token lifetimes in milliseconds: access 15 minutes, refresh 7 days.
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
ALLOWED_ORIGINS=http://localhost:3000

# Subscription service / SePay QR. Set enabled=true only after configuring linked bank + HMAC webhook.
SUBSCRIPTION_PORT=8083
SUBSCRIPTION_DEBUG_PORT=5004
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_MEMO_PREFIX=

# Gateway context: independent secrets, one for each backend (32+ random bytes).
GATEWAY_IAM_CONTEXT_SECRET=dev_gateway_iam_context_secret_at_least_32_bytes
GATEWAY_AUDIT_CONTEXT_SECRET=dev_gateway_audit_context_secret_at_least_32_bytes
GATEWAY_SUBSCRIPTION_CONTEXT_SECRET=dev_gateway_subscription_context_secret_at_least_32_bytes
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6380
AUTH_REDIS_DATABASE=0
AUTH_REDIS_PASSWORD=
AUTH_CACHE_PREFIX=vishop:
AUTH_CACHE_MAX_AGE_SECONDS=30
