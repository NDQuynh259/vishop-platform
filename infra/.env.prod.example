# =============================================================================
# ViShop Platform - Production Environment Template (.env.prod.example)
# =============================================================================
# Copy this file to .env.prod and update with real production credentials:
#   cp infra/.env.prod.example infra/.env.prod

SPRING_PROFILES_ACTIVE=prod

# --- Service HTTP Ports ---
GATEWAY_PORT=8000
IAM_PORT=8080
AUDIT_PORT=8082

# --- Database (Production PostgreSQL / RDS) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vishop_prod_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_VERY_SECURE_PASSWORD!
POSTGRES_DB=vishop_platform

# --- Message Broker (Production Kafka / MSK / Confluent) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Caching (Production Redis / ElastiCache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD

# --- Grafana Security ---
GRAFANA_ADMIN_USER=prod_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_STRONG_PASSWORD

# --- Distributed Tracing (Jaeger / Tempo / OpenTelemetry Collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

# --- JVM Production Memory & Performance ---
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# JWT signing secret: set a random value of at least 32 bytes.
JWT_SECRET=
# Token lifetimes in milliseconds: access 15 minutes, refresh 7 days.
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
ALLOWED_ORIGINS=http://localhost:3000
