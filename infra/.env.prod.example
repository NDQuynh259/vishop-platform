# =============================================================================
# ViShop Platform - Production Environment Template (.env.prod.example)
# =============================================================================
# Copy this file to .env.prod and update with real production credentials:
#   cp infra/.env.prod.example infra/.env.prod

SPRING_PROFILES_ACTIVE=prod

# --- Service HTTP Ports ---
GATEWAY_PORT=8000
IAM_PORT=8080
AUDIT_PORT=8082

# --- Database (Production PostgreSQL / RDS) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vishop_prod_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_VERY_SECURE_PASSWORD!
POSTGRES_DB=vishop_platform

# --- Message Broker (Production Kafka / MSK / Confluent) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Caching (Production Redis / ElastiCache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD

# --- Grafana Security ---
GRAFANA_ADMIN_USER=prod_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_STRONG_PASSWORD

# --- Distributed Tracing (Jaeger / Tempo / OpenTelemetry Collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

# --- JVM Production Memory & Performance ---
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# Gateway access JWT key. IAM authentication implementation has been removed.
JWT_ACCESS_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Subscription service / SePay QR. Set enabled=true only after configuring linked bank + HMAC webhook.
SUBSCRIPTION_PORT=8083
SUBSCRIPTION_DEBUG_PORT=5004
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_MEMO_PREFIX=

# Gateway context: independent secrets, one for each backend (32+ random bytes).
GATEWAY_IAM_CONTEXT_SECRET=
GATEWAY_AUDIT_CONTEXT_SECRET=
GATEWAY_SUBSCRIPTION_CONTEXT_SECRET=
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6380
AUTH_REDIS_DATABASE=0
AUTH_REDIS_PASSWORD=
AUTH_CACHE_PREFIX=vishop:
AUTH_CACHE_MAX_AGE_SECONDS=30
